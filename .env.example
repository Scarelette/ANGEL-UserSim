# The single place for keys, endpoints, deployment names and model paths.
#   cp .env.example .env    then fill in what you need (.env is gitignored).
# Every script loads <repo>/.env on start; variables exported in the shell win.
# model_usage needs none of these. Each module README lists what it reads.

# ---------------------------------------------------------------------------
# Model weights (paths or Hugging Face Hub ids). Defaults: <repo>/models/<name>
# ---------------------------------------------------------------------------
# ANGEL_OBSERVER_MODEL=models/Qwen3-Observer-800
# ANGEL_ACTOR_MODEL=models/qwen3-8b-dpo-merged
# ANGEL_EDGE_CLASSIFIER_MODEL=models/Qwen3-0.6B-Classifier
# ANGEL_BASE_MODEL=Qwen/Qwen3-8B
# EEYORE_MODEL=liusiyang/eeyore_sft_epoch2_dpo_round2_epoch1_llama3.1_8B
# ANGEL_MODELS_DIR=models
# ANGEL_DATA_DIR=data
# ANGEL_OUTPUT_DIR=outputs

# ---------------------------------------------------------------------------
# Azure OpenAI (GPT-5 data generation / judges, GPT-4.x therapist and baselines)
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment names on your resource (defaults shown)
# ANGEL_GPT5_DEPLOYMENT=gpt-5
# ANGEL_EDGE_JUDGE_DEPLOYMENT=gpt-5-mini          # observer S2 GRPO reward judge
# ANGEL_EDGE_CLASSIFIER_DEPLOYMENT=                # your fine-tuned edge classifier (no default)
# ANGEL_THERAPIST_DEPLOYMENT=gpt-4.1             # profile_expansion therapist (default); required by actor rollouts
# ANGEL_PATIENT_PSI_DEPLOYMENT=gpt-4
# ANGEL_ROLEPLAY_DOH_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_GPT_4O=gpt-4o           # safety_exp
# AZURE_OPENAI_DEPLOYMENT_GPT_5_2_CHAT=            # safety_exp

# Optional per-role overrides when a role lives on a different Azure resource
# (each falls back to AZURE_OPENAI_*):
# ANGEL_THERAPIST_AZURE_ENDPOINT=   ANGEL_THERAPIST_AZURE_API_KEY=
# ANGEL_BASELINE_AZURE_ENDPOINT=    ANGEL_BASELINE_AZURE_API_KEY=
# ANGEL_EDGE_JUDGE_ENDPOINT=        ANGEL_EDGE_JUDGE_API_KEY=
# ANGEL_EDGE_CLASSIFIER_ENDPOINT=   ANGEL_EDGE_CLASSIFIER_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic (judges, profile-variant generation, safety experiment)
# Leave ANTHROPIC_BASE_URL unset for api.anthropic.com; set it to an Azure AI
# Foundry ".../anthropic/" URL to use Foundry.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANGEL_JUDGE_DEPLOYMENT=claude-opus-4-6          # actor DPO preference judge

# ---------------------------------------------------------------------------
# Other providers (safety_exp; observer eval baselines)
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/service-account.json

# ---------------------------------------------------------------------------
# Hugging Face / Weights & Biases
# ---------------------------------------------------------------------------
# HF_TOKEN=
# WANDB_API_KEY=
# WANDB_PROJECT=
